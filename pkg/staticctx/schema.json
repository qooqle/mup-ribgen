{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["network_instances"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "network_instances": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "required": ["rd", "rt", "nexthop"],
          "additionalProperties": false,
          "properties": {
            "rd": {
              "type": "string",
              "pattern": "^[0-9]+:[0-9]+$"
            },
            "rt": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]+:[0-9]+$"
              },
              "minItems": 1
            },
            "source_address": {
              "type": "string"
            },
            "mup_extended_community": {
              "type": "object",
              "required": ["segment_identifier"],
              "additionalProperties": false,
              "properties": {
                "segment_identifier": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{12}$"
                }
              }
            },
            "endpoint_address_length": {
              "type": "integer",
              "minimum": 32,
              "maximum": 160
            },
            "nexthop": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
